<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Activation mandat SEPA - Frenchy Leurres</title>
  <style>
    *{box-sizing:border-box} body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#0f1117;color:#111;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px} .card{width:100%;max-width:560px;background:#fff;border-radius:22px;padding:30px;box-shadow:0 20px 60px rgba(0,0,0,.35)} h1{margin:0 0 10px;font-size:28px;line-height:1.1} p{line-height:1.5;color:#444} label{display:block;font-weight:700;margin-top:16px;margin-bottom:7px} input{width:100%;padding:14px 15px;border:1px solid #ccc;border-radius:12px;font-size:16px} button{width:100%;margin-top:22px;padding:16px;border:0;border-radius:14px;background:#111;color:#fff;font-weight:900;font-size:16px;cursor:pointer} button:disabled{opacity:.55;cursor:not-allowed}.note{font-size:13px;color:#666;margin-top:14px}.error{color:#b00020;font-weight:700;margin-top:14px}.brand{font-size:12px;letter-spacing:.08em;text-transform:uppercase;font-weight:900;color:#777;margin-bottom:10px}
  </style>
</head>
<body>
  <main class="card">
    <div class="brand">Frenchy Leurres</div>
    <h1>Activation du mandat SEPA professionnel</h1>
    <p>Veuillez renseigner vos informations. Vous serez ensuite redirigé vers Stripe afin d’enregistrer votre IBAN de manière sécurisée. Aucun paiement n’est déclenché sur cette page.</p>

    <form id="sepaForm">
      <label for="company">Nom de l’entreprise</label>
      <input id="company" name="company" required placeholder="Ex : CABEDIS / Magasin Cabesto" />

      <label for="contactName">Nom du contact</label>
      <input id="contactName" name="contactName" placeholder="Ex : Monsieur Dupont" />

      <label for="email">Email professionnel</label>
      <input id="email" name="email" type="email" required placeholder="contact@entreprise.fr" />

      <button id="submitBtn" type="submit">Activer le mandat SEPA</button>
      <div id="error" class="error"></div>
      <div class="note">Vos informations bancaires sont saisies directement sur Stripe. Frenchy Leurres ne voit pas et ne stocke pas votre IBAN.</div>
    </form>
  </main>

  <script>
    const form = document.getElementById('sepaForm');
    const button = document.getElementById('submitBtn');
    const errorBox = document.getElementById('error');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.textContent = '';
      button.disabled = true;
      button.textContent = 'Redirection sécurisée vers Stripe...';

      try {
        const payload = {
          company: form.company.value.trim(),
          contactName: form.contactName.value.trim(),
          email: form.email.value.trim()
        };

        const res = await fetch('/api/create-sepa-setup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (!data.ok || !data.url) throw new Error(data.error || 'Erreur lors de la création du mandat');

        window.location.href = data.url;
      } catch (err) {
        errorBox.textContent = err.message;
        button.disabled = false;
        button.textContent = 'Activer le mandat SEPA';
      }
    });
  </script>
</body>
</html>
